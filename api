# --------------------------------------------------------------
# Optional Hindsight client – falls back to in‑memory dict
# --------------------------------------------------------------
try:
    from hindsight import HindsightClient      # <-- real client if you have it
except Exception:   # pragma: no cover
    HindsightClient = None

class MemoryManager:
    """Per‑customer memory (Hindsight if available, else in‑memory)."""
    def __init__(self):
        self.client = HindsightClient() if HindsightClient else None
        self._fallback: Dict[str, List[str]] = {}

    async def _run(self, fn, *a, **kw):
        loop = asyncio.get_event_loop()
        return await loop.run_in_executor(None, lambda: fn(*a, **kw))

    async def retrieve(self, cust_id: str, query: str) -> List[str]:
        if self.client:
            try:
                res = await self._run(
                    self.client.search, collection=cust_id, query=query, top_k=5
                )
                return [r["content"] for r in res]
            except Exception as e:
                print("[Memory] Hindsight error:", e)
                return []
        # fallback – simple substring search
        store = self._fallback.get(cust_id, [])
        return [m for m in store if query.lower() in m.lower()][:5]

    async def store(self, cust_id: str, user_msg: str, agent_resp: str):
        entry = f"User: {user_msg}\nAgent: {agent_resp}"
        if self.client:
            try:
                await self._run(
                    self.client.upsert,
                    collection=cust_id,
                    documents=[{"content": entry}],
                )
            except Exception as e:
                print("[Memory] store error:", e)
        else:
            self._fallback.setdefault(cust_id, []).append(entry)

    async def count(self, cust_id: str) -> int:
        if self.client:
            try:
                meta = await self._run(self.client.get_collection_meta, name=cust_id)
                return meta.get("doc_count", 0)
            except Exception as e:
                print("[Memory] count error:", e)
                return 0
        return len(self._fallback.get(cust_id, []))


# --------------------------------------------------------------
# Groq LLM wrapper (OpenAI‑compatible)
# --------------------------------------------------------------
try:
    import groq
except Exception:   # pragma: no cover
    groq = None

async def generate_response(customer_id: str, user_msg: str,
                            session_hist: List[Dict[str, str]],
                            memories: List[str]) -> str:
    """Build prompt + call Groq (or return a mock)."""
    parts = []
    if memories:
        parts.append("Relevant prior incidents:")
        parts.extend(f"- {m}" for m in memories)
    parts.append(f"Customer ({customer_id}) says: {user_msg}")
    prompt = "\n".join(parts)

    if groq:
        try:
            client = groq.Groq(api_key=os.getenv("GROQ_API_KEY"))
            resp = await asyncio.get_event_loop().run_in_executor(
                None,
                lambda: client.chat.completions.create(
                    model=os.getenv("GROQ_MODEL", "llama-3.1-70b-versatile"),
                    messages=[
                        {"role": "system", "content": "You are a helpful support agent."},
                        {"role": "user", "content": prompt},
                    ],
                    temperature=0.7,
                ),
            )
            return resp.choices[0].message.content.strip()
        except Exception as e:
            print("[LLM] Groq error:", e)

    # mock fallback
    return f"[Mock] Received: {user_msg}"


# --------------------------------------------------------------
# FastAPI app (all routes in one file)
# --------------------------------------------------------------
app = FastAPI(title="MemoryDesk (Vercel)")
router = APIRouter()
mem_manager = MemoryManager()

# ---------- request/response models ----------
class ChatMessage(BaseModel):
    customer_id: str
    content: str
    use_memory: bool = True

class ChatResponse(BaseModel):
    response: str
    retrieved_memories: List[str] = []
    memory_count: int = 0

# ---------- API endpoint ----------
@router.post("/api/chat", response_model=ChatResponse)
async def chat_endpoint(msg: ChatMessage):
    memories = [] if not msg.use_memory else await mem_manager.retrieve(
        msg.customer_id, msg.content
    )
    resp_text = await generate_response(
        customer_id=msg.customer_id,
        user_msg=msg.content,
        session_hist=[],          # not persisted in this minimal version
        memories=memories,
    )
    # fire‑and‑forget store
    asyncio.create_task(
        mem_manager.store(msg.customer_id, msg.content, resp_text)
    )
    cnt = await mem_manager.count(msg.customer_id)
    return ChatResponse(
        response=resp_text,
        retrieved_memories=memories,
        memory_count=cnt,
    )

app.include_router(router)

