JS_CONTENT = """document.addEventListener('DOMContentLoaded', () => {
  const custSel = document.getElementById('customerSelect');
  const memToggle = document.getElementById('memoryToggle');
  const sendBtn = document.getElementById('sendBtn');
  const resetBtn = document.getElementById('resetBtn');
  const userInp = document.getElementById('userInput');
  const convDiv = document.getElementById('conversation');
  const memList = document.getElementById('memList');
  const memCnt = document.getElementById('memCount');
  const status = document.getElementById('status');

  const setStatus = (txt, emoji='🟢') => status.textContent = `${emoji} ${txt}`;
  const addMsg = (role, txt) => {
    const el = document.createElement('div');
    el.className = `message ${role}`;
    el.textContent = `${role==='user'?'You':'Agent'}: ${txt}`;
    convDiv.appendChild(el);
    convDiv.scrollTop = convDiv.scrollHeight;
  };
  const clearChat = () => {
    convDiv.innerHTML = '';
    memList.innerHTML = '';
    memCnt.textContent = '0';
    setStatus('Ready');
  };
  resetBtn.onclick = clearChat;

  sendBtn.onclick = async () => {
    const msg = userInp.value.trim();
    if (!msg) return;
    const cust = custSel.value;
    const useMem = memToggle.checked;
    addMsg('user', msg);
    userInp.value = '';
    setStatus('Waiting…', '⏳');
    try {
      const r = await fetch('/api/chat', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({customer_id:cust, content:msg, use_memory:useMem})
      });
      if (!r.ok) throw new Error('Network error');
      const data = await r.json();
      addMsg('agent', data.response);
      memList.innerHTML = '';
      data.retrieved_memories.forEach(m => {
        const li = document.createElement('li'); li.textContent=m; memList.appendChild(li);
      });
      memCnt.textContent = data.memory_count ?? data.retrieved_memories.length;
      setStatus('Ready');
    } catch (e) {
      console.error(e);
      addMsg('agent', 'Error – could not get a response.');
      setStatus('Error', '🔴');
    }
  };
});"""

